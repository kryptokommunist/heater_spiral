(kicad_sch (version 20230121) (generator eeschema)

  ;; ─────────────────────────────────────────────────────────────────────────
  ;; Heat Pixel Matrix Driver — 16×16
  ;; Based on: heater base 2 ESP32-C3 (existing design)
  ;; Architecture: 2× 74HC595 row high-side (AO3401A), 2× 74HC595 col low-side (AO3400A)
  ;; PWM blanking via OE# on col chain (ESP32 GPIO5)
  ;; ─────────────────────────────────────────────────────────────────────────

  (lib_symbols
    ;; ── ESP32-C3-MINI-1-H4 ──────────────────────────────────────────────────
    (symbol "ESP32-C3-MINI-1-H4"
      (pin input "GPIO0"  (at -7.62  6.35  0) (length 2.54))
      (pin input "GPIO1"  (at -7.62  3.81  0) (length 2.54))
      (pin input "GPIO2"  (at -7.62  1.27  0) (length 2.54))
      (pin input "GPIO3"  (at -7.62 -1.27  0) (length 2.54))
      (pin input "GPIO4"  (at -7.62 -3.81  0) (length 2.54))
      (pin input "GPIO5"  (at -7.62 -6.35  0) (length 2.54))
      (pin input "GPIO8"  (at  7.62  6.35 180) (length 2.54))
      (pin input "GPIO9"  (at  7.62  3.81 180) (length 2.54))
      (pin input "GPIO20" (at  7.62  1.27 180) (length 2.54))
      (pin input "GPIO21" (at  7.62 -1.27 180) (length 2.54))
      (pin input "GPIO18" (at  7.62 -3.81 180) (length 2.54))
      (pin input "GPIO19" (at  7.62 -6.35 180) (length 2.54))
      (pin power_in "3V3" (at  0     8.89  270) (length 2.54))
      (pin power_in "GND" (at  0    -8.89  90)  (length 2.54))
      (rectangle (start -6.35 7.62) (end 6.35 -7.62))
    )

    ;; ── 74HC595 (shift register) ────────────────────────────────────────────
    (symbol "74HC595"
      (pin input  "SER"    (at -7.62  6.35  0) (length 2.54))
      (pin input  "SRCLK"  (at -7.62  3.81  0) (length 2.54))
      (pin input  "RCLK"   (at -7.62  1.27  0) (length 2.54))
      (pin input  "OE_B"   (at -7.62 -1.27  0) (length 2.54))
      (pin input  "SRCLR_B" (at -7.62 -3.81 0) (length 2.54))
      (pin output "QA"     (at  7.62  6.35 180) (length 2.54))
      (pin output "QB"     (at  7.62  4.77 180) (length 2.54))
      (pin output "QC"     (at  7.62  3.18 180) (length 2.54))
      (pin output "QD"     (at  7.62  1.59 180) (length 2.54))
      (pin output "QE"     (at  7.62  0.00 180) (length 2.54))
      (pin output "QF"     (at  7.62 -1.59 180) (length 2.54))
      (pin output "QG"     (at  7.62 -3.18 180) (length 2.54))
      (pin output "QH"     (at  7.62 -4.77 180) (length 2.54))
      (pin output "QH_PRIME" (at 7.62 -6.35 180) (length 2.54))
      (pin power_in "VCC"  (at  0     8.89 270)  (length 2.54))
      (pin power_in "GND"  (at  0    -8.89  90)  (length 2.54))
      (rectangle (start -6.35 7.62) (end 6.35 -7.62))
    )

    ;; ── AO3400A (N-ch MOSFET) ───────────────────────────────────────────────
    (symbol "AO3400A"
      (pin input  "G"  (at -7.62 0 0)   (length 2.54))
      (pin passive "D" (at  0 5.08 270) (length 2.54))
      (pin passive "S" (at  0 -5.08 90) (length 2.54))
    )

    ;; ── AO3401A (P-ch MOSFET) ───────────────────────────────────────────────
    (symbol "AO3401A"
      (pin input  "G"  (at -7.62 0 0)   (length 2.54))
      (pin passive "D" (at  0 -5.08 90) (length 2.54))
      (pin passive "S" (at  0  5.08 270) (length 2.54))
    )

    ;; ── AMS1117-3.3 ─────────────────────────────────────────────────────────
    (symbol "AMS1117-3.3"
      (pin power_in  "IN"  (at -5.08 0 0)  (length 2.54))
      (pin power_out "OUT" (at  5.08 0 180) (length 2.54))
      (pin power_in  "GND" (at  0 -5.08 90) (length 2.54))
    )

    ;; ── MCP9808T-E/MC ───────────────────────────────────────────────────────
    (symbol "MCP9808"
      (pin bidirectional "SDA"   (at -7.62  2.54 0) (length 2.54))
      (pin input         "SCL"   (at -7.62  0    0) (length 2.54))
      (pin output        "ALERT" (at -7.62 -2.54 0) (length 2.54))
      (pin power_in      "GND"   (at  7.62 -2.54 180) (length 2.54))
      (pin input         "A2"    (at  7.62  2.54 180) (length 2.54))
      (pin input         "A1"    (at  7.62  1.27 180) (length 2.54))
      (pin input         "A0"    (at  7.62  0    180) (length 2.54))
      (pin power_in      "VDD"   (at  7.62  3.81 180) (length 2.54))
      (rectangle (start -5.08 5.08) (end 5.08 -5.08))
    )
  )

